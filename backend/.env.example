# Server
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENVIRONMENT=local
APP_URL=http://localhost:8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rust_axum_app
DB_MAX_CONNECTIONS=10

# Keycloak
KEYCLOAK_REALM_URL=http://localhost:9000/realms/rust-axum-app
KEYCLOAK_CLIENT_ID=rust-axum-app
KEYCLOAK_CLIENT_SECRET=rust-axum-app-local-secret
KEYCLOAK_AUDIENCE=rust-axum-app
AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUTH_POST_LOGIN_URL=http://localhost:3000/

# Sessions
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=rust-axum-app
SESSION_COOKIE_SECURE=false
SESSION_INACTIVITY_TIMEOUT=36000

# Files: `s3` or `local`; each file keeps the storage it was uploaded to
FILES_STORAGE=s3
FILES_MAX_SIZE=26214400
FILES_UPLOAD_DIR=uploads
FILES_BASE_URL=/uploads
FILES_SIGNING_KEY=rust-axum-app-local-files-signing-key

# Object storage, the local Garage
S3_ENDPOINT=http://localhost:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=rust-axum-app-files
S3_ACCESS_KEY=GK3a7c1e9b5d2f4086a1c3e5b7
S3_SECRET_KEY=9d4f2b7e1a6c3058b9e2d7f4a1c6b3e8d5f2a9c7e4b1d8f3a6c9e2b5d7f1a4c8

# E-mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rust-axum-app.local
