# Server
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ENVIRONMENT=local
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rust_axum_app
DB_MAX_CONNECTIONS=10

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:9000
KEYCLOAK_REALM=rust-axum-app
KEYCLOAK_CLIENT_ID=rust-axum-app
KEYCLOAK_CLIENT_SECRET=rust-axum-app-local-secret
KEYCLOAK_AUDIENCE=rust-axum-app
AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUTH_POST_LOGIN_URL=http://localhost:3000/api/auth/session

# Sessions
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_SECURE=false
SESSION_INACTIVITY_TIMEOUT=36000

# Files
FILES_UPLOAD_DIR=uploads
FILES_BASE_URL=/uploads

# E-mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rust-axum-app.local
