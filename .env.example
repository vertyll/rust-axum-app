# Server
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ENVIRONMENT=development
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rust_axum_app
DB_MAX_CONNECTIONS=10

# Security
JWT_ACCESS_TOKEN_SECRET=change-me-access
JWT_ACCESS_TOKEN_EXPIRES_IN=3600
JWT_REFRESH_TOKEN_SECRET=change-me-refresh
JWT_REFRESH_TOKEN_EXPIRES_IN=2592000
CONFIRMATION_TOKEN_SECRET=change-me-confirmation
CONFIRMATION_TOKEN_EXPIRES_IN=86400

# Files
FILES_UPLOAD_DIR=uploads
FILES_BASE_URL=/uploads

# E-mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=app@example.com
EMAIL_TEMPLATES_DIR=resources/templates/emails
