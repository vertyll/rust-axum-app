# Read by `docker compose -f docker-compose.local.yml` from a `.env` next to it, at the repository's root.
# The applications read their own `.env` in `backend/` and `frontend/`; keep the values they share equal.

# PostgreSQL
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rust_axum_app

# Garage: the bucket, its key, and the origin its CORS rule lets upload and download
S3_BUCKET=rust-axum-app-files
S3_ACCESS_KEY=GK3a7c1e9b5d2f4086a1c3e5b7
S3_SECRET_KEY=9d4f2b7e1a6c3058b9e2d7f4a1c6b3e8d5f2a9c7e4b1d8f3a6c9e2b5d7f1a4c8
FRONTEND_ORIGIN=http://localhost:3000
